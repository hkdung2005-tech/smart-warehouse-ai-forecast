# ─────────────────────────────────────────────
# Smart Warehouse AI Forecast — Environment Variables
# Sao chép file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git
# ─────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=warehouse

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Queue names — đồng bộ với worker/config.py của Bảo
MAIN_QUEUE=jobs
DLQ=jobs.dlq
# Retry queues được Worker tự tạo động: jobs.retry.1s, jobs.retry.2s, jobs.retry.4s

# Worker config
MAX_RETRIES=3
RATE_LIMIT_PER_SECOND=10
PREFETCH_COUNT=1

# Mock Gemini URL (Đại implement)
GEMINI_API_URL=http://localhost:9000/generate
GEMINI_API_KEY=
