# ─────────────────────────────────────────────
# Smart Warehouse AI Forecast — Environment Variables
# Sao chép file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git
# ─────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse
POSTGRES_DB=warehouse_db

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Queue names (nhất quán với Worker)
RABBITMQ_MAIN_QUEUE=warehouse.jobs.main
RABBITMQ_RETRY_QUEUE=warehouse.jobs.retry
RABBITMQ_DLQ=warehouse.jobs.dlq

# Số lần retry tối đa trước khi vào DLQ
MAX_RETRY_COUNT=3
